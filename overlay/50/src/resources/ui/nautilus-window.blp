using Gtk 4.0;
using Adw 1;

menu app_menu {
  section {
    item {
      label: _("New _Window");
      action: "app.clone-window";
      verb-icon: "window-new-symbolic";
    }

    item {
      label: _("New _Tab");
      action: "win.new-tab";
      verb-icon: "tab-new-symbolic";
    }
  }

  section undo_redo_section {
    /* Note: This section is often recreated by undo_manager_changed() to
     * change the labels of the actions. If you change anything here,
     * remember to change in the code as well.
     */
    item {
      label: _("_Undo");
      action: "win.undo";
    }

    item {
      label: _("_Redo");
      action: "win.redo";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Help");
      action: "app.help";
    }

    item {
      label: _("_About Files");
      action: "app.about";
    }
  }
}

menu tab_menu_model {
  section {
    item {
      label: _("_New Tab");
      action: "win.new-tab";
    }

    item {
      label: _("Re_store Closed Tab");
      action: "win.restore-tab";
    }
  }

  section {
    item {
      label: _("Move Tab to New _Window");
      action: "win.tab-move-new-window";
    }

    item {
      /* Translators: use “Move Tab _Right” for RTL languages */
      label: _("Move Tab _Left");
      action: "win.tab-move-left";
    }

    item {
      /* Translators: use “Move Tab _Left” for RTL languages */
      label: _("Move Tab _Right");
      action: "win.tab-move-right";
    }
  }

  section {
    item {
      label: _("_Close Tab");
      action: "win.close-current-view";
    }

    item {
      label: _("Close _Other Tabs");
      action: "win.close-other-tabs";
    }
  }
}

/* Windows Explorer style classic menu bar (File / Edit / View / Go / Help). */
menu menubar_model {
  submenu {
    label: _("_File");

    item {
      label: _("New _Window");
      action: "app.new-window";
      icon: "window-new-symbolic";
    }

    item {
      label: _("New _Tab");
      action: "win.new-tab";
      icon: "tab-new-symbolic";
    }

    item {
      label: _("New _Folder");
      action: "view.new-folder";
      icon: "folder-new-symbolic";
    }

    section {
      item {
        label: _("_Close Tab");
        action: "win.close-current-view";
      }

      item {
        label: _("_Quit");
        action: "app.quit";
      }
    }
  }

  submenu {
    label: _("_Edit");

    item {
      label: _("_Undo");
      action: "win.undo";
      icon: "edit-undo-symbolic";
    }

    item {
      label: _("_Redo");
      action: "win.redo";
    }

    section {
      item {
        label: _("Cu_t");
        action: "view.cut";
        icon: "edit-cut-symbolic";
      }

      item {
        label: _("_Copy");
        action: "view.copy";
        icon: "edit-copy-symbolic";
      }

      item {
        label: _("_Paste");
        action: "view.paste";
        icon: "edit-paste-symbolic";
      }
    }

    section {
      item {
        label: _("Select _All");
        action: "view.select-all";
        icon: "edit-select-all-symbolic";
      }

      item {
        label: _("_Rename…");
        action: "view.rename";
        icon: "document-edit-symbolic";
      }

      item {
        label: _("_Delete");
        action: "view.move-to-trash";
        icon: "user-trash-symbolic";
      }
    }

    section {
      item {
        label: _("P_roperties");
        action: "view.properties";
        icon: "document-properties-symbolic";
      }
    }
  }

  submenu {
    label: _("_View");

    item {
      label: _("Zoom _In");
      action: "view.zoom-in";
      icon: "zoom-in-symbolic";
    }

    item {
      label: _("Zoom _Out");
      action: "view.zoom-out";
      icon: "zoom-out-symbolic";
    }

    item {
      label: _("_Normal Size");
      action: "view.zoom-standard";
    }

    section {
      item {
        label: _("Show _Hidden Files");
        action: "view.show-hidden-files";
      }
    }
  }

  submenu {
    label: _("_Go");

    item {
      label: _("_Back");
      action: "slot.back";
      icon: "go-previous-symbolic";
    }

    item {
      label: _("_Forward");
      action: "slot.forward";
      icon: "go-next-symbolic";
    }

    item {
      label: _("_Home");
      action: "win.go-home";
    }
  }

  submenu {
    label: _("_Help");

    item {
      label: _("_Help");
      action: "app.help";
    }

    item {
      label: _("_About Files");
      action: "app.about";
    }
  }
}

template $NautilusWindow: Adw.ApplicationWindow {
  height-request: 380;
  show-menubar: false;
  title: bind template.active-slot as <$NautilusWindowSlot>.title;

  styles [
    "view",
  ]

  $NautilusShortcutManager {
    child: Adw.ToastOverlay toast_overlay {
      child: Adw.OverlaySplitView split_view {
        enable-show-gesture: false;
        enable-hide-gesture: false;
        max-sidebar-width: 240;
        sidebar-width-unit: px;
        sidebar-width-fraction: 0.2;

        sidebar: Adw.ToolbarView {
          reveal-bottom-bars: bind progress_indicator.reveal;

          [top]
          Adw.HeaderBar {
            decoration-layout: ":minimize,maximize,close";

            [start]
            ToggleButton {
              tooltip-text: _("Search Everywhere");
              action-name: "slot.search-global";
              icon-name: "edit-find-symbolic";
            }

            title-widget: Adw.WindowTitle {
              title: _("Files");
            };

            [end]
            MenuButton {
              tooltip-text: _("Main Menu");
              icon-name: "open-menu-symbolic";
              menu-model: app_menu;
            }
          }

          [bottom]
          Box {
            styles [
              "toolbar",
            ]

            $NautilusProgressIndicator progress_indicator {}
          }

          content: $NautilusSidebar places_sidebar {
            vexpand: true;
            window-slot: bind template.active-slot;
          };
        };

        content: Adw.ToolbarView {
          [top]
          $NautilusToolbar toolbar {
            show-view-controls: true;
            show-history-controls: true;
            sidebar-button-active: bind split_view.show-sidebar bidirectional;
            window-slot: bind template.active-slot;
          }


          /* Windows Explorer style: classic menu bar below the title/address bar. */
          [top]
          PopoverMenuBar menubar {
            menu-model: menubar_model;
            halign: fill;
          }

          /* Windows Explorer style: command bar (existing GNOME view.* actions). */
          [top]
          Box command_bar {
            styles [
              "toolbar",
              "command-bar",
            ]
            spacing: 6;

            Button {
              action-name: "view.new-folder";
              tooltip-text: _("New Folder");
              focus-on-click: false;

              child: Box {
                spacing: 6;
                Image { icon-name: "folder-new-symbolic"; }
                Label { label: _("New"); }
              };
            }

            Button {
              action-name: "view.cut";
              tooltip-text: _("Cut");
              focus-on-click: false;

              child: Box {
                spacing: 6;
                Image { icon-name: "edit-cut-symbolic"; }
                Label { label: _("Cut"); }
              };
            }

            Button {
              action-name: "view.copy";
              tooltip-text: _("Copy");
              focus-on-click: false;

              child: Box {
                spacing: 6;
                Image { icon-name: "edit-copy-symbolic"; }
                Label { label: _("Copy"); }
              };
            }

            Button {
              action-name: "view.paste";
              tooltip-text: _("Paste");
              focus-on-click: false;

              child: Box {
                spacing: 6;
                Image { icon-name: "edit-paste-symbolic"; }
                Label { label: _("Paste"); }
              };
            }

            Button {
              action-name: "view.rename";
              tooltip-text: _("Rename");
              focus-on-click: false;

              child: Box {
                spacing: 6;
                Image { icon-name: "document-edit-symbolic"; }
                Label { label: _("Rename"); }
              };
            }

            Button {
              action-name: "view.move-to-trash";
              tooltip-text: _("Move to Trash");
              focus-on-click: false;

              child: Box {
                spacing: 6;
                Image { icon-name: "user-trash-symbolic"; }
                Label { label: _("Delete"); }
              };
            }

            Button {
              action-name: "view.properties";
              tooltip-text: _("Properties");
              focus-on-click: false;

              child: Box {
                spacing: 6;
                Image { icon-name: "document-properties-symbolic"; }
                Label { label: _("Properties"); }
              };
            }

          }

          [top]
          Adw.TabBar tab_bar {
            view: tab_view;
          }

          content: Stack content_stack {
            transition-type: none;

            StackPage {
              name: "files";

              child: Adw.TabView tab_view {
                menu-model: tab_menu_model;
              };
            }

            StackPage {
              name: "home";

              child: ScrolledWindow home_page {
                hscrollbar-policy: never;

                child: Box {
                  orientation: vertical;
                  spacing: 16;
                  margin-top: 28;
                  margin-bottom: 28;
                  margin-start: 28;
                  margin-end: 28;

                  Label {
                    xalign: 0;
                    label: _("Home");
                    styles [ "title-1" ]
                  }

                  Label {
                    xalign: 0;
                    label: _("Quick access");
                    styles [ "heading" ]
                  }

                  Box quick_access_box {
                    spacing: 12;
                  }

                  Box {
                    spacing: 24;
                    homogeneous: true;

                    Box {
                      orientation: vertical;
                      spacing: 8;
                      hexpand: true;

                      Label {
                        xalign: 0;
                        label: _("Favorites");
                        styles [ "heading" ]
                      }

                      ListBox home_favorites {
                        selection-mode: none;
                        styles [ "home-list" ]
                      }
                    }

                    Box {
                      orientation: vertical;
                      spacing: 8;
                      hexpand: true;

                      Label {
                        xalign: 0;
                        label: _("Recent items");
                        styles [ "heading" ]
                      }

                      ListBox home_recents {
                        selection-mode: none;
                        styles [ "home-list" ]
                      }
                    }
                  }
                }
              }
            }
          };

          [bottom]
          $NautilusNetworkAddressBar network_address_bar {
            visible: false;
          }

          [bottom]
          ActionBar action_bar {
            revealed: false;

            [start]
            $NautilusHistoryControls {
              window-slot: bind template.active-slot;
            }

            [end]
            $NautilusViewControls {
              window-slot: bind template.active-slot;
            }
          }

          [bottom]
          Box status_bar {
            spacing: 12;
            margin-start: 10;
            margin-end: 10;
            margin-top: 3;
            margin-bottom: 3;

            styles [
              "status-bar",
            ]

            Label status_bar_left {
              xalign: 0;
              hexpand: true;
              ellipsize: end;
            }

            Label status_bar_right {
              xalign: 1;
            }
          }

        };
      };
    };
  }

  Adw.Breakpoint {
    condition ("max-width: 682sp")

    setters {
      split_view.collapsed: true;
      split_view.enable-show-gesture: true;
      split_view.enable-hide-gesture: true;
      toolbar.show-sidebar-button: true;
      toolbar.show-view-controls: false;
      toolbar.show-history-controls: false;
      action_bar.revealed: true;
      progress_indicator.popover-position: 2;
    }
  }
}
